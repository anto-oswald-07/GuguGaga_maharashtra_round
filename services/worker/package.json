{
  "name": "worker",
  "version": "0.0.1",
  "private": true,
  "description": "CreatorAi background worker (AI consumers + media helpers)",
  "exports": {
    "./jobs/extractMetadata": "./src/jobs/extractMetadata.ts",
    "./media/thumbnail": "./src/media/thumbnail.ts",
    "./media/extractAudio": "./src/media/extractAudio.ts",
    "./media/cutClip": "./src/media/cutClip.ts",
    "./media/renderTimeline": "./src/media/renderTimeline.ts",
    "./media/adaptAspect": "./src/media/adaptAspect.ts",
    "./media/generateSceneMedia": "./src/media/generateSceneMedia.ts",
    "./consumers/generateScript": "./src/consumers/generateScript.ts",
    "./consumers/transcribe": "./src/consumers/transcribe.ts",
    "./consumers/align": "./src/consumers/align.ts",
    "./consumers/renderClip": "./src/consumers/renderClip.ts",
    "./consumers/scoreClips": "./src/consumers/scoreClips.ts",
    "./consumers/generateTimeline": "./src/consumers/generateTimeline.ts",
    "./consumers/renderTimeline": "./src/consumers/renderTimeline.ts",
    "./consumers/generatePlatformCopy": "./src/consumers/generatePlatformCopy.ts",
    "./consumers/adaptPlatform": "./src/consumers/adaptPlatform.ts",
    "./ai/provider": "./src/ai/provider.ts",
    "./ai/transcribe": "./src/ai/transcribe.ts",
    "./ai/align": "./src/ai/align.ts",
    "./ai/scoreClips": "./src/ai/scoreClips.ts",
    "./ai/proposeTimeline": "./src/ai/proposeTimeline.ts",
    "./ai/generatePlatformCopy": "./src/ai/generatePlatformCopy.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "extract-meta": "tsx src/jobs/extractMetadata.ts",
    "generate-script": "tsx src/consumers/generateScript.ts",
    "transcribe": "tsx src/consumers/transcribe.ts",
    "align": "tsx src/consumers/align.ts",
    "render-clip": "tsx src/consumers/renderClip.ts",
    "score-clips": "tsx src/consumers/scoreClips.ts",
    "generate-timeline": "tsx src/consumers/generateTimeline.ts",
    "render-timeline": "tsx src/consumers/renderTimeline.ts",
    "generate-platform-copy": "tsx src/consumers/generatePlatformCopy.ts",
    "adapt-platform": "tsx src/consumers/adaptPlatform.ts"
  },
  "dependencies": {
    "@creatorai/ai-provider": "workspace:*",
    "@creatorai/shared": "workspace:*",
    "@creatorai/timeline-schema": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
