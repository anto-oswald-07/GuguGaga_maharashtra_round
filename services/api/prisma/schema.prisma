// CreatorAi API — Prisma schema
// Phase 1: bootstrap only (no User/domain models yet).
// Models arrive in later phases per DEVELOPMENT_PLAN (Auth in Phase 2, etc.).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Intentionally empty of models for Phase 1 Health-only API.
