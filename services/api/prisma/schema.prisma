// CreatorAi API — Prisma schema
// Phase 2: User + Workspace for auth.
// Phase 3: Asset + local storage paths.
// Phase 4: Project + ProjectAsset + StageEvent.
// Phase 5: ScriptDocument + ScriptVersion + Job (DB-polling queue).
// Phase 6: Transcript + TranscriptSegment + ScriptFootageMap.
// Phase 7: ClipCandidate (propose / accept / render → Asset).
// Phase 8: EditTimeline + TimelineVersion (editable JSON + AI proposals).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AssetType {
  VIDEO
  IMAGE
  AUDIO
  DOCUMENT
  OTHER
}

enum ProjectStage {
  IDEA
  SCRIPT
  RECORDED
  EDITING
  CLIPS
  ADAPTED
  READY
  PUBLISHED
}

enum Platform {
  YOUTUBE
  YOUTUBE_SHORTS
  INSTAGRAM_REELS
  TIKTOK
  LINKEDIN
}

enum JobType {
  TRANSCRIBE
  ALIGN_SCRIPT
  SCORE_CLIPS
  RENDER_CLIP
  RENDER_TIMELINE
  GENERATE_TIMELINE
  ADAPT_PLATFORM
  GENERATE_SCRIPT
  GENERATE_HOOKS
  GENERATE_SUPPORTING
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum ScriptSource {
  USER
  AI
  REFINE
}

/// Clip candidate lifecycle (SDD §5.6 / FR-CLP-*).
enum ClipCandidateStatus {
  PROPOSED
  ACCEPTED
  REJECTED
  RENDERED
}

/// Timeline version provenance (FR-ED-006 — AI never silent-overwrites).
enum TimelineSource {
  USER
  AI_PROPOSAL
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  passwordHash String
  name         String
  createdAt    DateTime   @default(now())
  workspace    Workspace?
}

model Workspace {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @unique @db.Uuid
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  assets    Asset[]
  projects  Project[]
  jobs      Job[]
}

model Asset {
  id          String         @id @default(uuid()) @db.Uuid
  workspaceId String         @db.Uuid
  type        AssetType
  name        String
  path        String
  mime        String
  size        BigInt
  tags        String[]       @default([])
  description String?
  metadata    Json           @default("{}")
  deletedAt   DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  workspace          Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projects           ProjectAsset[]
  transcripts        Transcript[]
  clipSources        ClipCandidate[] @relation("ClipSourceAsset")
  clipRenderedFrom   ClipCandidate[] @relation("ClipRenderedAsset")
  timelinePreviews   EditTimeline[]  @relation("TimelinePreviewAsset")

  @@index([workspaceId, deletedAt])
  @@index([workspaceId, type])
}

model Project {
  id              String             @id @default(uuid()) @db.Uuid
  workspaceId     String             @db.Uuid
  title           String
  description     String?
  stage           ProjectStage       @default(IDEA)
  targetPlatforms Platform[]         @default([])
  deletedAt       DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  workspace       Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assets          ProjectAsset[]
  stageEvents     StageEvent[]
  scripts         ScriptDocument[]
  jobs            Job[]
  transcripts     Transcript[]
  mappings        ScriptFootageMap[]
  clipCandidates  ClipCandidate[]
  timelines       EditTimeline[]

  @@index([workspaceId, deletedAt])
  @@index([workspaceId, stage])
}

model ProjectAsset {
  projectId  String   @db.Uuid
  assetId    String   @db.Uuid
  attachedAt DateTime @default(now())
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  asset      Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@id([projectId, assetId])
  @@index([assetId])
}

model StageEvent {
  id        String        @id @default(uuid()) @db.Uuid
  projectId String        @db.Uuid
  fromStage ProjectStage?
  toStage   ProjectStage
  createdAt DateTime      @default(now())
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

/// One script document per logical draft inside a project (versioned content).
model ScriptDocument {
  id        String             @id @default(uuid()) @db.Uuid
  projectId String             @db.Uuid
  title     String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  project         Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions        ScriptVersion[]
  mappings        ScriptFootageMap[]
  clipCandidates  ClipCandidate[]

  @@index([projectId, createdAt])
}

model ScriptVersion {
  id               String         @id @default(uuid()) @db.Uuid
  scriptDocumentId String         @db.Uuid
  version          Int
  /// Structured content: `{ hook, body, cta, title?, rawText? }`
  content          Json
  source           ScriptSource   @default(USER)
  createdAt        DateTime       @default(now())
  scriptDocument   ScriptDocument @relation(fields: [scriptDocumentId], references: [id], onDelete: Cascade)

  @@unique([scriptDocumentId, version])
  @@index([scriptDocumentId, createdAt])
}

/// Background work unit. MVP queue = DB polling (status=QUEUED); Redis/BullMQ optional later.
model Job {
  id          String     @id @default(uuid()) @db.Uuid
  workspaceId String     @db.Uuid
  projectId   String?    @db.Uuid
  type        JobType
  status      JobStatus  @default(QUEUED)
  input       Json       @default("{}")
  output      Json?
  error       String?
  progress    Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project     Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@index([workspaceId, createdAt])
  @@index([status, createdAt])
}

/// Transcription of a project footage asset (SDD §4.1 / Phase 6).
model Transcript {
  id        String               @id @default(uuid()) @db.Uuid
  projectId String               @db.Uuid
  assetId   String               @db.Uuid
  language  String               @default("en")
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  project         Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  asset           Asset                @relation(fields: [assetId], references: [id], onDelete: Cascade)
  segments        TranscriptSegment[]
  mappings        ScriptFootageMap[]
  clipCandidates  ClipCandidate[]

  @@index([projectId, createdAt])
  @@index([projectId, assetId])
  @@index([assetId])
}

model TranscriptSegment {
  id           String     @id @default(uuid()) @db.Uuid
  transcriptId String     @db.Uuid
  /// Display / playback order within the transcript.
  ordinal      Int
  startMs      Int
  endMs        Int
  text         String
  transcript   Transcript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)

  @@index([transcriptId, ordinal])
}

/// Script section ↔ footage time range (AI align or user correction).
model ScriptFootageMap {
  id               String          @id @default(uuid()) @db.Uuid
  projectId        String          @db.Uuid
  transcriptId     String?         @db.Uuid
  scriptDocumentId String?         @db.Uuid
  /// Script section label / excerpt shown in Mapping UI.
  scriptRef        String
  startMs          Int
  endMs            Int
  /// 0–1; UI highlights low confidence (see shared LOW_CONFIDENCE_THRESHOLD).
  confidence       Float
  /// AI = align job; USER = manual PATCH.
  source           String          @default("AI")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  project          Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  transcript       Transcript?     @relation(fields: [transcriptId], references: [id], onDelete: SetNull)
  scriptDocument   ScriptDocument? @relation(fields: [scriptDocumentId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([transcriptId])
  @@index([scriptDocumentId])
}

/// AI-proposed (or user-tweaked) short clip window from long-form footage.
model ClipCandidate {
  id               String              @id @default(uuid()) @db.Uuid
  projectId        String              @db.Uuid
  /// Long-form source video/audio being clipped.
  sourceAssetId    String              @db.Uuid
  transcriptId     String?             @db.Uuid
  scriptDocumentId String?             @db.Uuid
  title            String
  startMs          Int
  endMs            Int
  /// 0–1 score from clip scorer (FR-CLP-002).
  score            Float
  rationale        String?
  status           ClipCandidateStatus @default(PROPOSED)
  /// Set when RENDER_CLIP succeeds (0..1 Asset).
  renderedAssetId  String?             @unique @db.Uuid
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  project          Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceAsset      Asset               @relation("ClipSourceAsset", fields: [sourceAssetId], references: [id], onDelete: Cascade)
  transcript       Transcript?         @relation(fields: [transcriptId], references: [id], onDelete: SetNull)
  scriptDocument   ScriptDocument?     @relation(fields: [scriptDocumentId], references: [id], onDelete: SetNull)
  renderedAsset    Asset?              @relation("ClipRenderedAsset", fields: [renderedAssetId], references: [id], onDelete: SetNull)

  @@index([projectId, status])
  @@index([projectId, createdAt])
  @@index([sourceAssetId])
  @@index([transcriptId])
  @@index([scriptDocumentId])
}

/// Editable edit-decision document for a project (SDD §4.1 / §5.7).
model EditTimeline {
  id               String            @id @default(uuid()) @db.Uuid
  projectId        String            @db.Uuid
  title            String?
  /// Points at the applied/saved version only — AI proposals never update this.
  currentVersionId String?           @unique @db.Uuid
  /// Last successful RENDER_TIMELINE preview asset (optional).
  previewAssetId   String?           @db.Uuid
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  project          Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  currentVersion   TimelineVersion?  @relation("TimelineCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  previewAsset     Asset?            @relation("TimelinePreviewAsset", fields: [previewAssetId], references: [id], onDelete: SetNull)
  versions         TimelineVersion[] @relation("TimelineVersions")

  @@index([projectId, createdAt])
  @@index([previewAssetId])
}

model TimelineVersion {
  id             String         @id @default(uuid()) @db.Uuid
  editTimelineId String         @db.Uuid
  version        Int
  /// Edit timeline JSON (schemaVersion 1.0 — see shared / timeline-schema).
  content        Json
  source         TimelineSource @default(USER)
  createdAt      DateTime       @default(now())
  editTimeline   EditTimeline   @relation("TimelineVersions", fields: [editTimelineId], references: [id], onDelete: Cascade)
  currentFor     EditTimeline?  @relation("TimelineCurrentVersion")

  @@unique([editTimelineId, version])
  @@index([editTimelineId, createdAt])
}
