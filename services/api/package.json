{
  "name": "api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "prisma:generate": "dotenv run -f ../../.env -- prisma generate",
    "prisma:validate": "dotenv run -f ../../.env -- prisma validate",
    "prisma:migrate": "dotenv run -f ../../.env -- prisma migrate dev",
    "prisma:deploy": "dotenv run -f ../../.env -- prisma migrate deploy"
  },
  "dependencies": {
    "@creatorai/ai-provider": "workspace:*",
    "@creatorai/shared": "workspace:*",
    "@fastify/cors": "^11.0.1",
    "@fastify/multipart": "^10.1.2",
    "@prisma/client": "^6.3.1",
    "bcrypt": "^5.1.1",
    "dotenv": "^18.0.5",
    "fastify": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "worker": "workspace:*"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.10.7",
    "dotenv-cli": "^11.0.0",
    "prisma": "^6.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
