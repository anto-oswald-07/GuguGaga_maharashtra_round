{
  "name": "api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "prisma:generate": "dotenv run -f ../../.env -- prisma generate",
    "prisma:validate": "dotenv run -f ../../.env -- prisma validate"
  },
  "dependencies": {
    "@creatorai/shared": "workspace:*",
    "@prisma/client": "^6.3.1",
    "dotenv": "^18.0.5",
    "fastify": "^5.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "dotenv-cli": "^11.0.0",
    "prisma": "^6.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
