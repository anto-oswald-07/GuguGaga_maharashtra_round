# Copy to .env and adjust as needed.
# DATABASE_URL matches docker-compose.yml defaults (host port 5432).
# If host :5432 is already taken, set POSTGRES_HOST_PORT=5433 and:
#   DATABASE_URL=postgresql://creatorai:creatorai@localhost:5433/creatorai

POSTGRES_HOST_PORT=5432
DATABASE_URL=postgresql://creatorai:creatorai@localhost:5432/creatorai
JWT_SECRET=change-me-in-local-dev
PORT=4000
STORAGE_ROOT=./storage

# AI (Phase 5) — never commit real keys; default mock needs none
AI_PROVIDER=mock
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# Job poller inside API (set JOB_POLLER=0 to disable; worker CLI still available)
# JOB_POLL_MS=750
# JOB_POLLER=1
# Optional: worker POSTs job completion here (replace :id with job id)
# WORKER_CALLBACK_URL=http://localhost:4000/api/v1/internal/jobs/:id/complete
# WORKER_INTERNAL_TOKEN=

# Optional (MVP queue: DB-polling; Redis kept optional for later BullMQ)
# REDIS_URL=redis://localhost:6379
