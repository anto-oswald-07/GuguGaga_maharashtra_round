# Copy to .env and adjust as needed.
# DATABASE_URL matches docker-compose.yml defaults (host port 5432).
# If host :5432 is already taken, set POSTGRES_HOST_PORT=5433 and:
#   DATABASE_URL=postgresql://creatorai:creatorai@localhost:5433/creatorai

POSTGRES_HOST_PORT=5432
DATABASE_URL=postgresql://creatorai:creatorai@localhost:5432/creatorai
JWT_SECRET=change-me-in-local-dev
PORT=4000
STORAGE_ROOT=./storage

# AI (Phase 5–6) — never commit real keys; default mock needs none
AI_PROVIDER=mock
# Optional: deterministic mock variation lane (Phase 10). Same seed → same scripts/hooks.
# AI_MOCK_SEED=creatorai-demo
# Prefer auto to try free/cheap backends in order when keys are set:
# AI_PROVIDER=auto
# AI_FALLBACK=1
# AI_FALLBACK_PROVIDERS=gemini,openrouter,groq,mistral,openai,grok,mock
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_WHISPER_MODEL=whisper-1
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# OpenRouter (prefer a concrete :free chat model)
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=qwen/qwen3.8-27b:free
# Groq (free tier rate limits)
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b
# Mistral
# MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-small-latest
# xAI Grok (OpenAI-compatible). New accounts often get signup credits at console.x.ai
# AI_PROVIDER=grok
# XAI_API_KEY=
# XAI_MODEL=grok-4.3
# Job poller inside API (set JOB_POLLER=0 to disable; worker CLI still available)
# JOB_POLL_MS=750
# JOB_POLLER=1
# Optional: worker POSTs job completion here (replace :id with job id)
# WORKER_CALLBACK_URL=http://localhost:4000/api/v1/internal/jobs/:id/complete
# WORKER_INTERNAL_TOKEN=

# Optional (MVP queue: DB-polling; Redis kept optional for later BullMQ)
# REDIS_URL=redis://localhost:6379
